---
import Page from '../layouts/Page.astro';
import { sections, essays } from '../data/content.js';

const s = sections.writing;
const fmtDate = (iso) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const SITE = 'https://gregjones.io';

/**
 * The essays are hosted on Substack, so this page is modelled honestly as a
 * list that points at them rather than as the articles themselves: each item
 * carries the canonical Substack URL and credits the same Person node the rest
 * of the site uses. That is what lets an answer engine connect "who wrote this"
 * to the entity, instead of treating each essay as an orphan.
 */
const essayGraph = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE}/writing/#page`,
  name: 'Writing by Greg Jones',
  about: { '@id': `${SITE}#person` },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: essays.length,
    itemListElement: essays.map((e, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Article',
        headline: e.title,
        url: e.href,
        datePublished: e.date,
        abstract: e.summary,
        author: { '@id': `${SITE}#person` },
        publisher: { '@id': `${SITE}#person` },
        isAccessibleForFree: true,
      },
    })),
  },
};
---

<Page
  title="Writing · Greg Jones"
  description="Essays on how small, high-trust organizations achieve institutional excellence: the discipline and leverage of an institution without the headcount, bureaucracy, or pace."
  ogImage="/og/writing.png"
  heading="Writing"
  lede={s.body[0]}
>
  <div class="prose">
    <p>{s.body[1]}</p>

    <h2>Essays</h2>
    <ol class="essays">
      {essays.map((e) => (
        <li class="essay">
          <h3 class="essay__title">
            <a href={e.href} rel="noopener" target="_blank">{e.title}</a>
          </h3>
          <p class="essay__date meta"><time datetime={e.date}>{fmtDate(e.date)}</time></p>
          <p class="essay__summary">{e.summary}</p>
        </li>
      ))}
    </ol>

    <h2>Subscribe</h2>
    <p>New essays weekly. No cadence promises beyond that, and nothing sent that is not finished.</p>
    <p><a href={s.cta.href} rel="noopener" target="_blank">{s.cta.label}</a></p>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(essayGraph).replace(/</g, '\\u003c')} />
</Page>

<style>
  .essays { list-style: none; padding: 0; margin: 18px 0 0; }
  .essay { border-top: 1px solid var(--line); padding: 26px 0; max-width: 68ch; }
  .essay:first-child { border-top: 0; padding-top: 8px; }
  .essay__title { font-size: 20px; font-weight: 500; letter-spacing: -0.005em; line-height: 1.3; }
  .essay__date { margin: 8px 0 0; font-size: 12px; }
  .essay__summary { margin: 12px 0 0; color: var(--muted); }
</style>
