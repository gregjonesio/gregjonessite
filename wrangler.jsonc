{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gregjonessite",
  "compatibility_date": "2025-06-01",
  // Worker entry-point: first-party analytics (/api/beacon, /api/stats).
  // All other requests fall through to the static assets below.
  "main": "worker/index.js",
  // Static Astro site served from the built `dist/` directory
  // (Cloudflare Workers Static Assets). Assets are matched before the
  // Worker runs, so only non-asset paths (e.g. /api/*) hit the code.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Astro builds pages as directories, so /about/ is the canonical URL and
    // the one the sitemap, the nav and the page's own <link rel=canonical>
    // all use. Pinning the policy keeps it from being inferred: under the
    // default ("auto-trailing-slash") the direction of the redirect depends
    // on whether a route happens to emit foo/index.html or foo.html, so a
    // single page built the other way would start redirecting the opposite
    // way and split the canonical form across the site.
    // dist/_redirects (generated at build time) upgrades the 307 this issues
    // to a 301 for known routes; this is the backstop for everything else.
    "html_handling": "force-trailing-slash",
    // /api/* must always reach the Worker (POST beacons were otherwise
    // answered by the asset layer with a 404).
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "STATS", "class_name": "SiteStats" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiteStats"] }],
  // Build the static output before upload, so `dist/` always exists in CI.
  "build": {
    "command": "npm run build"
  }
}
